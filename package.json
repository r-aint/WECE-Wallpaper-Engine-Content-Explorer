{
  "name": "we-content-manager",
  "productName": "WE Content Manager",
  "version": "1.0.1",
  "description": "Wallpaper Engine 订阅内容管理器 — 浏览、预览并打开创意工坊订阅内容",
  "author": "RAint0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win dir",
    "dist:nsis": "electron-builder --win nsis"
  },
  "keywords": [
    "wallpaper-engine",
    "steam",
    "workshop",
    "electron"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.wecontent.manager",
    "productName": "WE Content Manager",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WE Content Manager",
      "uninstallDisplayName": "WE Content Manager ${version}",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "artifactName": "WECE-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^24.13.3"
  }
}
